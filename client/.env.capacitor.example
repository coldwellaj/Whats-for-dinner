VITE_GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# Required for native builds: the app bundle ships inside the device/emulator with no Vercel
# rewrite in front of it, so API calls need the deployed server's full URL (no trailing slash).
VITE_API_URL="https://api.rotisserie-app.com/api"

# Required for native Google Sign-In on iOS only (Android and the plugin's server verification
# both reuse VITE_GOOGLE_CLIENT_ID above, the "Web application" OAuth client). This must be the
# separate "iOS" OAuth client created in Google Cloud Console for this app's bundle ID.
VITE_GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"
