Database_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
PORT=3001
SESSION_SECRET="a-long-random-string-used-to-sign-session-cookies"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Optional: enables notification emails (friend requests, family invites). Without these
# set, the app still works — sending is skipped and a warning is logged instead.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="What's for Dinner <onboarding@resend.dev>"
APP_URL="http://localhost:5173"
