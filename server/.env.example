Database_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
PORT=3001
SESSION_SECRET="a-long-random-string-used-to-sign-session-cookies"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Optional: enables notification emails (friend requests, family invites). Without these
# set, the app still works — sending is skipped and a warning is logged instead.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Rotisserie <onboarding@resend.dev>"
APP_URL="http://localhost:5173"

# Optional: comma-separated extra origins allowed to call the API with credentials, beyond
# the built-in capacitor://localhost / https://localhost used by the native app shell. The
# web client doesn't need an entry here since it reaches the API same-origin via the Vercel
# rewrite.
CORS_ORIGINS=""
