generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("Database_DATABASE_URL")
}

// Enums aren't used for mealType/status so the same schema shape carried over cleanly
// from SQLite; they're validated application-side against the MealType/MealPlanStatus
// union types in src/lib/types.ts.

model User {
  id           String   @id @default(cuid())
  googleId     String?  @unique
  passwordHash String?
  email        String   @unique
  // Stored lowercased (like email) so uniqueness is effectively case-insensitive; optional —
  // Postgres unique constraints allow any number of NULLs, so users without one don't collide.
  username     String?  @unique
  name         String?
  picture      String?
  createdAt    DateTime @default(now())

  // Friends visibility settings: "ALL" | "FRIENDS" | "PRIVATE" (app-validated, see
  // src/lib/types.ts). Default PRIVATE so existing/new users don't get opted into
  // sharing activity with anyone until they choose to.
  mealPlanVisibility     String @default("PRIVATE")
  recentlyMadeVisibility String @default("PRIVATE")
  recipeListVisibility   String @default("PRIVATE")

  familyId      String?
  family        Family?  @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)
  ownedFamilies Family[] @relation("FamilyOwner")

  recipes           Recipe[]
  mealPlanEntries   MealPlanEntry[]
  shoppingListItems ShoppingListItem[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
}

// A friendship, one row per pair. Starts PENDING (created by the requester) and becomes
// ACCEPTED once the addressee accepts; either row shape is queried symmetrically once
// accepted (see lib/friends.ts) since the request direction no longer matters at that point.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING") // "PENDING" | "ACCEPTED"
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// A shared household: recipes/meal-plan/shopping-list scope to the family once a
// member has one, instead of to that individual user. Someone with no family keeps
// their own personal scope (see Recipe/MealPlanEntry/ShoppingListItem below).
model Family {
  id        String   @id @default(cuid())
  name      String?
  ownerId   String
  createdAt DateTime @default(now())

  owner   User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  members User[]         @relation("FamilyMembers")
  invites FamilyInvite[]

  recipes           Recipe[]
  mealPlanEntries   MealPlanEntry[]
  shoppingListItems ShoppingListItem[]
}

// A pending invite for an email that hasn't signed in yet; resolved into family
// membership the first time that email completes Google sign-in.
model FamilyInvite {
  id        String   @id @default(cuid())
  familyId  String
  email     String
  invitedBy String
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, email])
  @@index([email])
}

model Recipe {
  id               String             @id @default(cuid())
  userId           String
  familyId         String?
  name             String
  description      String?
  instructions     String?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  servings         Int?
  sourceUrl        String?
  isFavorite       Boolean            @default(false)
  isShared         Boolean            @default(false) // shareable: visible to any signed-in user via the Discover page
  saveCount        Int                @default(0) // times other users have copied this shared recipe; drives Discover's popularity sort
  // Set on a recipe created via POST /:id/copy to the shared recipe it was copied from, so the
  // copy route can detect "you already saved this" and Discover can show that state up front.
  // Left in place even if the caller later un-shares or deletes their copy of the source.
  copiedFromId     String?
  tags             String? // comma-separated for MVP
  // Photo bytes are deliberately excluded from every list/detail query (see recipes.ts) and
  // served instead via GET /:id/photo, so list responses (which can include dozens of
  // recipes) stay small and the browser can cache each image like a normal <img src>. hasPhoto
  // lets the client know whether to render that <img> at all without fetching the bytes.
  photo            Bytes?
  photoType        String?
  hasPhoto         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  family           Family?            @relation(fields: [familyId], references: [id], onDelete: SetNull)
  ingredients      RecipeIngredient[]
  mealPlanEntries  MealPlanEntry[]

  @@index([userId])
  @@index([familyId])
  @@index([isShared])
  @@index([copiedFromId])
}

model Ingredient {
  id                String             @id @default(cuid())
  name              String             @unique
  defaultUnit       String?
  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         String?
  notes        String?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  familyId  String?
  date      DateTime
  mealType  String
  recipeId  String
  status    String   @default("PLANNED")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([recipeId])
  @@index([date])
}

model ShoppingListItem {
  id            String      @id @default(cuid())
  userId        String
  familyId      String?
  weekStartDate String // stored as YYYY-MM-DD key for the week
  ingredientId  String?
  customName    String?
  quantity      Float?
  unit          String?
  isChecked     Boolean     @default(false)
  isManual      Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  family        Family?     @relation(fields: [familyId], references: [id], onDelete: SetNull)
  ingredient    Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStartDate, ingredientId])
  @@index([familyId, weekStartDate])
  @@index([userId, weekStartDate])
}
