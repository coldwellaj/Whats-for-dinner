generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("Database_DATABASE_URL")
}

// Enums aren't used for mealType/status so the same schema shape carried over cleanly
// from SQLite; they're validated application-side against the MealType/MealPlanStatus
// union types in src/lib/types.ts.

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())

  recipes           Recipe[]
  mealPlanEntries   MealPlanEntry[]
  shoppingListItems ShoppingListItem[]
}

model Recipe {
  id               String             @id @default(cuid())
  userId           String
  name             String
  description      String?
  instructions     String?
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  servings         Int?
  sourceUrl        String?
  isFavorite       Boolean            @default(false)
  tags             String? // comma-separated for MVP
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients      RecipeIngredient[]
  mealPlanEntries  MealPlanEntry[]

  @@index([userId])
}

model Ingredient {
  id                String             @id @default(cuid())
  name              String             @unique
  defaultUnit       String?
  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         String?
  notes        String?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mealType  String
  recipeId  String
  status    String   @default("PLANNED")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([date])
}

model ShoppingListItem {
  id            String      @id @default(cuid())
  userId        String
  weekStartDate String // stored as YYYY-MM-DD key for the week
  ingredientId  String?
  customName    String?
  quantity      Float?
  unit          String?
  isChecked     Boolean     @default(false)
  isManual      Boolean     @default(false)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient    Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStartDate, ingredientId])
  @@index([userId, weekStartDate])
}
